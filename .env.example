# Copy to .env.local and adjust as needed. All values are optional.

# Where the SQLite database file is stored (relative to the project root).
DATABASE_PATH=./data/learning-assistant.db

# Claude model used for generation and grading.
CLAUDE_MODEL=claude-opus-5-5

# Maximum time (ms) a single Claude request may take before it is aborted.
AI_TIMEOUT_MS=180000

# Authentication: by default the app uses the Claude Code login on this machine
# (your Claude subscription). Run `claude` once and log in if you haven't.
# Setting ANTHROPIC_API_KEY instead switches to pay-as-you-go API billing.
