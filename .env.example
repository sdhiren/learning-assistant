# Copy to .env.local and adjust as needed. All values are optional.

# Where the SQLite database file is stored (relative to the project root).
DATABASE_PATH=./data/learning-assistant.db

# Which AI provider generates and grades content:
#   claude-code  (default) your Claude subscription, through the Claude Code login on this machine.
#                Run `claude` once and log in if you haven't. Any ANTHROPIC_API_KEY is ignored.
#   anthropic    the Anthropic API, billed per token to ANTHROPIC_API_KEY.
#   openai       the OpenAI API (GPT), billed per token to OPENAI_API_KEY.
#   gemini       the Gemini API, billed to GEMINI_API_KEY (create one in Google AI Studio).
AI_PROVIDER=claude-code

# Model id. Defaults to the provider's default: claude-opus-5-5 (claude-code, anthropic),
# gpt-5 (openai) or gemini-2.5-pro (gemini). With openai, an override must be a reasoning
# model (gpt-5 family or o-series): other models reject the reasoning effort the app sends.
# AI_MODEL=claude-opus-5-5

# API keys, needed only for the matching AI_PROVIDER. Never commit them.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Deprecated: use AI_MODEL. Still honoured for claude-code and anthropic when AI_MODEL is unset.
# CLAUDE_MODEL=claude-opus-5-5

# Maximum time (ms) a single AI request may take, including retries, before it is aborted.
AI_TIMEOUT_MS=180000
