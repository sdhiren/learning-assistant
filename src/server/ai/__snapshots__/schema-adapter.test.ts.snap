          "name": {
            "description": "Short concept name, e.g. 'Event loop phases'.",
            "type": "string",
          },
          "summary": {
            "description": "One sentence on what the learner must understand.",
            "type": "string",
          },
        },
        "required": [
          "name",
          "summary",
        ],
        "type": "object",
      },
      "maxItems": 6,
      "minItems": 2,
      "type": "array",
    },
    "name": {
      "description": "A concise, clean title for the subtopic (fix casing and typos; keep its meaning).",
      "type": "string",
    },
  },
  "required": [
    "name",
    "concepts",
  ],
  "type": "object",
}
`;

